"""
teams.py

Módulo responsável por enviar notificações para canais do
Microsoft Teams utilizando Webhooks e Adaptive Cards.
"""

# Biblioteca utilizada para realizar requisições HTTP
import requests

# Biblioteca utilizada para registro de logs
import logging

# Utilizada para indicar parâmetros opcionais
from typing import Optional


def _get_log(log: Optional[logging.Logger]) -> logging.Logger:
    """
    Retorna o logger informado.

    Caso nenhum logger seja enviado, utiliza
    o logger padrão do módulo.

    Args:
        log (logging.Logger, opcional):
            Logger personalizado.

    Returns:
        logging.Logger
    """

    return log if log else logging.getLogger(__name__)


def enviar_notificacao_teams(
    mensagem: str,
    webhook_url: str,
    log: Optional[logging.Logger] = None
) -> bool:
    """
    Envia uma mensagem para um canal do Microsoft Teams.

    Args:
        mensagem (str):
            Texto que será exibido no Teams.

        webhook_url (str):
            URL do Webhook configurado no Teams.

        log (logging.Logger, opcional):
            Logger utilizado para registrar eventos.

    Returns:
        bool:
            True  -> Envio realizado com sucesso.
            False -> Ocorreu algum erro.
    """

    # Obtém o logger que será utilizado
    logger = _get_log(log)

    # ==========================================================
    # Validação da mensagem
    # ==========================================================
    if not mensagem:
        logger.error("Mensagem não informada.")
        return False

    # ==========================================================
    # Validação da URL do Webhook
    # ==========================================================
    if not webhook_url:
        logger.error("Webhook URL não informada.")
        return False

    # ==========================================================
    # Monta o payload que será enviado ao Teams
    # ==========================================================
    payload = {
        "type": "message",
        "attachments": [
            {
                "contentType": (
                    "application/vnd.microsoft.card.adaptive"
                ),
                "content": {
                    "$schema": (
                        "http://adaptivecards.io/schemas/"
                        "adaptive-card.json"
                    ),
                    "type": "AdaptiveCard",
                    "version": "1.2",
                    "body": [
                        {
                            "type": "TextBlock",

                            # Texto recebido como parâmetro
                            "text": mensagem,

                            # Permite quebra automática de linha
                            "wrap": True
                        }
                    ]
                }
            }
        ]
    }

    try:

        # ======================================================
        # Envia a mensagem para o Microsoft Teams
        # ======================================================
        response = requests.post(
            webhook_url,
            json=payload,
            timeout=30
        )

        # Verifica se houve erro HTTP
        response.raise_for_status()

        # Log de sucesso
        logger.info(
            "Notificação enviada com sucesso para o Microsoft Teams."
        )

        return True

    except requests.RequestException as erro:

        # ======================================================
        # Tratamento de erros de comunicação
        # ======================================================
        logger.error(
            f"Erro ao enviar notificação para o Teams: {erro}"
        )

        return False


# ==============================================================
# Exemplo de utilização
# ==============================================================
if __name__ == "__main__":

    webhook = "https://seu-webhook-aqui"

    resultado = enviar_notificacao_teams(
        mensagem="Processo executado com sucesso!",
        webhook_url=webhook
    )

    print(f"Resultado do envio: {resultado}")
